DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
# "backend" precisa estar na lista — é o Host: que o Next.js manda ao
# chamar o Django pela rede interna do compose (http://backend:8000).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

CORS_ALLOWED_ORIGINS=

FERNET_KEY=

TINY_OAUTH_TOKEN_URL=
TINY_OAUTH_AUTHORIZE_URL=
TINY_API_BASE_URL=

# Passo 10: URL pública do próprio backend (usada para montar a redirect_uri
# registrada no app do Tiny — não depende do Host da requisição) e URL do
# frontend (para onde o callback OAuth redireciona depois de processar o
# retorno do Tiny). Local: http://localhost:8000 / http://localhost:3000.
# Produção: https://sync-api.automasoluct.com.br / https://sync.automasoluct.com.br.
PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:3000

REDIS_URL=

POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432

BACKEND_INTERNAL_URL=
